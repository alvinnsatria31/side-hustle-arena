# Locked architecture:
# - Deploy: Vercel (serverless). Set APP_ENV=production in Vercel project settings.
# - Text/metadata/state: Neon PostgreSQL (use the pooled connection string on Vercel).
# - File bytes: Tencent Cloud COS, private bucket, S3-compatible API.
DATABASE_URL=
APP_ENV=development

SK_AUTH_ORIGIN=
ARENA_ORIGIN=
ARENA_SSO_CLIENT_ID=
ARENA_SSO_CLIENT_SECRET=
ARENA_SSO_INTROSPECTION_INTERVAL_SECONDS=
ARENA_ALLOWED_ORIGINS=

# Tencent Cloud COS (canonical). The endpoint is the REGIONAL one — the SDK
# prepends the bucket itself, so a bucket-scoped endpoint would double it.
# Optional when bucket+region are set (derived automatically):
# https://cos.ap-jakarta.myqcloud.com
STORAGE_BUCKET=
STORAGE_REGION=ap-jakarta
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT=

# Internal automation (Hermes/VPS worker bearer token). Fail-closed: when unset,
# every /api/internal/* call is denied. Generate with: openssl rand -hex 32
INTERNAL_AUTOMATION_TOKEN=

# Scheduled jobs (/api/cron/*). Vercel Cron sends this as a bearer token; set it
# in the Vercel project and Vercel attaches it automatically. Fail-closed: with
# neither this nor INTERNAL_AUTOMATION_TOKEN set, every cron call is denied.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# External grading ingest (VPS/n8n engine → /api/webhooks/arena-eval).
# Separate least-privilege token. Generate with: openssl rand -hex 32
ARENA_EVAL_TOKEN=

# Outbound events to the n8n box (fire-and-forget, best-effort).
VPS_WEBHOOK_BASE_URL=http://202.74.75.95/webhook
VPS_WEBHOOK_TOKEN=

# Outbound email through Resend (own key; never routed via the main site).
RESEND_API_KEY=
ARENA_FROM_EMAIL=

# Reward code fulfillment contract (main-site checkout). Pending agreement —
# voucher push reports contract-pending until these are set.
MAIN_SITE_ORIGIN=
MAIN_SITE_VOUCHER_TOKEN=

# AI reviewer provider. "stub" is development-only (deterministic, labeled).
# Real provider wiring (OpenAI-compatible) lands with AI_API_KEY provisioning.
AI_REVIEW_PROVIDER=stub
AI_API_BASE_URL=
AI_API_KEY=
AI_REVIEW_MODEL=
AI_VALIDATOR_MODEL=
AI_JUDGE_MODEL=

# Transitional fallback for existing local .env files (R2). Prefer STORAGE_* above.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

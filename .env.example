# Locked architecture:
# - Deploy: Vercel (serverless). Set APP_ENV=production in Vercel project settings.
# - Text/metadata/state: Neon PostgreSQL (use the pooled connection string on Vercel).
# - File bytes: Tencent Cloud COS, private bucket, S3-compatible API.
DATABASE_URL=
APP_ENV=development

# Sign-in gate. SK_AUTH_ORIGIN is the main site that serves /arena — use the
# `www` host in production (the apex only 308-redirects to it); defaults to
# https://www.sekolahkarir.id when unset. ARENA_ALLOWED_ORIGINS is the origin
# allowlist for state-changing requests: the Arena's own origin (the default).
# Production refuses any entry that is neither ARENA_ORIGIN nor SK_AUTH_ORIGIN.
SK_AUTH_ORIGIN=
ARENA_ORIGIN=
ARENA_ALLOWED_ORIGINS=

# Sign-in. The Arena issues no session of its own: it verifies the Sekolah Karir
# participant cookie (sk_participant), an HS256 JWT the main site signs. Both
# values must match the main site exactly or every visitor reads as logged out.
#   SESSION_SECRET — the same signing secret sekolah-karir-website uses.
#   COOKIE_DOMAIN  — the registrable domain the cookie is scoped to in
#                    production (sekolahkarir.id), so this subdomain receives it
#                    and so logout can actually clear it. Leave blank locally,
#                    where the main site sets a host-only cookie.
SESSION_SECRET=
COOKIE_DOMAIN=

# SSO bridge (PKCE authorize/callback/introspection). NOT on the sign-in path
# today — kept for the day the main site grows a token endpoint. See
# docs/backend/AUTH_INTEGRATION_CONTRACT.md. Optional: leave blank and only the
# dormant bridge is unavailable. Signing in never reads these.
ARENA_SSO_CLIENT_ID=
ARENA_SSO_CLIENT_SECRET=
ARENA_SSO_INTROSPECTION_INTERVAL_SECONDS=

# Tencent Cloud COS (canonical). The endpoint is the REGIONAL one — the SDK
# prepends the bucket itself, so a bucket-scoped endpoint would double it.
# Optional when bucket+region are set (derived automatically):
# https://cos.ap-jakarta.myqcloud.com
STORAGE_BUCKET=
STORAGE_REGION=ap-jakarta
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT=

# Internal automation (Hermes/VPS worker bearer token). Fail-closed: when unset,
# every /api/internal/* call is denied. Generate with: openssl rand -hex 32
INTERNAL_AUTOMATION_TOKEN=

# Scheduled jobs (/api/cron/*). Vercel Cron sends this as a bearer token; set it
# in the Vercel project and Vercel attaches it automatically. Fail-closed: with
# neither this nor INTERNAL_AUTOMATION_TOKEN set, every cron call is denied.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# External grading ingest (VPS/n8n engine → /api/webhooks/arena-eval).
# Separate least-privilege token. Generate with: openssl rand -hex 32
ARENA_EVAL_TOKEN=

# Outbound events to the n8n box (fire-and-forget, best-effort).
# Security: a custom base URL must be HTTPS when the token is set, otherwise
# delivery is refused. Plain HTTP is grandfathered only for the legacy box
# below (and loopback) with a loud warning — migrate the box to HTTPS.
VPS_WEBHOOK_BASE_URL=http://202.74.75.95/webhook
VPS_WEBHOOK_TOKEN=

# Outbound email through Resend (own key; never routed via the main site).
RESEND_API_KEY=
ARENA_FROM_EMAIL=

# Reward code fulfillment contract (main-site checkout). Pending agreement —
# voucher push reports contract-pending until these are set.
MAIN_SITE_ORIGIN=
MAIN_SITE_VOUCHER_TOKEN=

# AI reviewer + generator provider (OpenAI-compatible chat completions).
# The live key lives on the Hermes VPS (202.74.75.95, n8n box) — copy
# AI_API_BASE_URL + AI_API_KEY + the model names from there into Vercel env
# (production) / .env (local). Never commit the real key. Without these, the
# review worker fails closed and generation runs library-only.
# "openai" and "openai-compatible" both select that transport and are
# interchangeable; "stub" is development-only (deterministic, labeled,
# refused outside dev).
AI_REVIEW_PROVIDER=stub
AI_API_BASE_URL=
AI_API_KEY=
AI_REVIEW_MODEL=
AI_VALIDATOR_MODEL=
AI_JUDGE_MODEL=
AI_GENERATION_MODEL=

# Weekly generation policy (read by generationConfig; all optional).
# ARENA_GENERATION_ENABLED=true is required for the unattended project-generate
# job to do anything: without it the job reports "generation disabled" and the
# Monday cycle produces nothing. ARENA_AUTO_PUBLISH_ENABLED=true lets the cron
# publish when the preview/publication guards pass, otherwise projects wait
# for preview approval. Neither flag gates the admin console's manual release
# (POST /api/internal/admin/launch) - an operator asking for a specific week is
# a deliberate act, and gating it here would make the console useless exactly
# when the timer is off and someone needs to recover.
ARENA_GENERATION_ENABLED=
ARENA_AUTO_PUBLISH_ENABLED=
ARENA_GENERATION_WINDOW_WEEKS=
ARENA_GENERATION_SIMILARITY_THRESHOLD=
ARENA_GENERATION_PREVIEW_HOURS=

# Arena admin access (see src/server/admin/auth.ts). INTERNAL_ADMIN_TOKEN must
# differ from INTERNAL_AUTOMATION_TOKEN; actor identity comes from
# INTERNAL_ADMIN_SUBJECT (never from request bodies) and scopes from
# INTERNAL_ADMIN_SCOPES (subset of: overview reviews weeks projects rewards
# users storage). Session fallback: ARENA_ADMIN_SUBJECTS (full access) and
# ARENA_ADMIN_ROLES (JSON subject→scopes).
INTERNAL_ADMIN_TOKEN=
INTERNAL_ADMIN_SUBJECT=
INTERNAL_ADMIN_SCOPES=
ARENA_ADMIN_SUBJECTS=
ARENA_ADMIN_ROLES=

# Transitional fallback for existing local .env files (R2). Prefer STORAGE_* above.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# CV Scanner. Hidden everywhere until this is exactly "true": the navigation
# entries, the landing-page CTA and the /api/cv-scan route all read it, so the
# feature cannot be half-launched. The scan reuses the AI_API_* provider above;
# CV Scanner. AI_CV_MODEL is optional and falls back to AI_REVIEW_MODEL.
#
# The scan may need a different provider than the reviewer. The reviewer grades
# in a background worker where thinking time is free; the scan runs inside a
# request the platform kills at 60s (Hobby). A reasoning model is right for the
# first and disqualifying for the second — deepseek-v4-flash measured 18-91s on
# the same CV, so it cannot be used here.
#
# Point the scan at a fast NON-reasoning provider by setting both of:
#   AI_CV_API_BASE_URL  https://api.groq.com/openai/v1
#   AI_CV_API_KEY       that provider's own key
#   AI_CV_MODEL         openai/gpt-oss-120b
# Measured on that combination: 2.9s end to end, against 90.7s on the reasoning
# model. Free tier allows ~4 scans/minute (8,000 tokens per minute, ~2,000 per
# scan); past that the provider answers 429 and the route returns 503.
# The key must accompany its own base URL; setting the URL alone is refused
# rather than falling back to AI_API_KEY, which would hand one provider's
# credential to another's endpoint. Leave both unset and the scan simply
# borrows the reviewer's provider.
NEXT_PUBLIC_CV_SCANNER_ENABLED=
AI_CV_MODEL=
AI_CV_API_BASE_URL=
AI_CV_API_KEY=
# The endpoint's TOTAL hourly ceiling, across every caller. The per-IP limit
# (5/hour, not configurable) caps one script; it does nothing about a thousand
# of them, so this is the number that actually bounds the bill. Unset means 300.
# Lowering it takes effect immediately, without a deploy.
CV_SCAN_HOURLY_CAP=

# --- Jobs (Career) ----------------------------------------------------------
# The pipeline is provider-agnostic: a source is a row in arena.job_sources
# (adapter + non-secret config + the NAME of the env var holding its token), so
# connecting a real board needs no code change. See docs/backend/JOBS_PIPELINE.md.
#
# A source that needs a credential names its own variable — e.g. a row with
# credential_env_var = JOBS_PROVIDER_TOKEN reads the value from here. Add one
# line per provider; nothing else about the provider belongs in the environment.
# JOBS_PROVIDER_TOKEN=
#
# Optional: an external careers portal linked from the Jobs page. HTTPS only,
# no embedded credentials, and never presented as a source of live openings.
JOBS_PORTAL_URL=

# --- Off-schedule project release (admin console + n8n) ---------------------
# The console at /app/admin/jobs and n8n/arena-adhoc-launch-workflow.json both
# POST /api/internal/admin/launch. n8n authenticates with INTERNAL_ADMIN_TOKEN
# above, whose INTERNAL_ADMIN_SCOPES must include `projects`; in n8n set
# ARENA_BASE_URL and ARENA_ADMIN_TOKEN to match. No extra variable is needed -
# see the generation policy block above for the flags that govern the timer.

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "sin1"
  ],
  "crons": [
    {
      "path": "/api/cron/week-close",
      "schedule": "5 17 * * *"
    },
    {
      "path": "/api/cron/week-finalize",
      "schedule": "20 17 * * *"
    },
    {
      "path": "/api/cron/email-flush",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/week-notifications",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/cron/session-cleanup",
      "schedule": "30 18 * * *"
    },
    {
      "path": "/api/cron/storage-cleanup",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/project-generate",
      "schedule": "0 2 * * 0"
    },
    {
      "path": "/api/cron/project-drop",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/jobs-sync",
      "schedule": "20 20 * * *"
    }
  ]
}

# Voucher contract with the Sekolah Karir main site. Never commit the real token.
MAIN_SITE_ORIGIN=https://sekolahkarir.id
MAIN_SITE_VOUCHER_TOKEN=<token_rahasia_voucher>

# Example only: use the credential variable named by arena.job_sources.
JOBS_PROVIDER_TOKEN=<token_rahasia_provider_lowongan>

# Toko produk digital. Biarkan NEXT_PUBLIC_STORE_ENABLED kosong sampai katalog
# diisi dan pembayaran diuji — konsol admin /app/admin/store tetap bisa dipakai
# saat toko masih tertutup. Kunci Midtrans hanya dibutuhkan jalur Rupiah; jalur
# poin jalan tanpa semuanya. Pakai pasangan kunci merchant yang sama dengan
# website utama, dan JANGAN ubah Payment Notification URL di dashboard: setiap
# transaksi Arena menunjuk webhook-nya sendiri lewat X-Override-Notification.
NEXT_PUBLIC_STORE_ENABLED=
MIDTRANS_SERVER_KEY=<server_key_midtrans>
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=<client_key_midtrans>
MIDTRANS_ENVIRONMENT=production

# Runtime env for the self-hosted career product. Copy to `arena.env` (gitignored)
# and fill in. Most values are the CURRENT Vercel production values — pull them
# with `vercel env pull vercel.prod.env --environment=production` and map across.
# A few already live on this box inside the sk-n8n container.
#
# APP_ENV / NODE_ENV / PORT / HOSTNAME are set by the compose file, not here.

# ---- Data plane (required) ------------------------------------------------
# Postgres runs on this box (sk-arena-db). Generate the password once:
#   PW=$(openssl rand -hex 24)
# then set BOTH of these to it, and point DATABASE_URL at the same URL.
POSTGRES_PASSWORD=
LOCAL_DATABASE_URL=postgresql://arena:<POSTGRES_PASSWORD>@sk-arena-db:5432/arena
DATABASE_URL=postgresql://arena:<POSTGRES_PASSWORD>@sk-arena-db:5432/arena

# The pre-migration managed database. Kept ONLY as a handle on the old
# participant data (enrollments, submissions, reviews, points), which was left
# behind when its free-tier transfer quota was exhausted. The app never reads
# this; it needs a paid month or a quota reset before pg_dump will work.
NEON_DATABASE_URL=

# ---- Sign-in (required) -------------------------------------------------------
# Public origin of this deployment. Keep it the real domain even before DNS
# cutover so cookies and redirects are correct once traffic lands.
ARENA_ORIGIN=https://arena.sekolahkarir.id
# Main site that serves the login gate. www host in production.
SK_AUTH_ORIGIN=https://www.sekolahkarir.id
# State-change origin allowlist. Defaults to ARENA_ORIGIN; set explicitly.
ARENA_ALLOWED_ORIGINS=https://arena.sekolahkarir.id
# HS256 secret the main site signs the sk_participant cookie with. Must match
# sekolah-karir-website exactly or every visitor reads as logged out.
SESSION_SECRET=
# Registrable domain the cookie is scoped to, so this subdomain receives it and
# logout can clear it.
COOKIE_DOMAIN=sekolahkarir.id

# ---- Object storage (required) ----------------------------------------------
# Tencent Cloud COS, private bucket, S3-compatible. Endpoint is derived from
# bucket+region when left blank (regional shape: https://cos.<region>.myqcloud.com).
STORAGE_BUCKET=
STORAGE_REGION=ap-jakarta
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT=

# ---- Automation tokens (required) ------------------------------------------
# CRON_SECRET: bearer token n8n's scheduler workflow already sends as
# ARENA_CRON_TOKEN. Read the current value from the sk-n8n container
# (`docker inspect sk-n8n`) and use the SAME string here.
CRON_SECRET=
# Claims/closes review leases + guards /api/internal/*. Same as Vercel
# INTERNAL_AUTOMATION_TOKEN and n8n's INTERNAL_AUTOMATION_TOKEN. Must differ
# from INTERNAL_ADMIN_TOKEN.
INTERNAL_AUTOMATION_TOKEN=
# Legacy grading ingest (/api/webhooks/arena-eval). Separate least-privilege token.
ARENA_EVAL_TOKEN=

# ---- Email (required for notifications) ------------------------------------
RESEND_API_KEY=
ARENA_FROM_EMAIL=

# ---- AI provider (required for grading + generation) ----------------------
# Values already on this box in sk-n8n: AI_API_BASE_URL / AI_API_KEY.
# "openai" and "openai-compatible" name the same OpenAI-shaped endpoint.
AI_REVIEW_PROVIDER=openai
AI_API_BASE_URL=
AI_API_KEY=
AI_REVIEW_MODEL=
AI_VALIDATOR_MODEL=
AI_JUDGE_MODEL=
AI_GENERATION_MODEL=

# ---- Weekly generation policy -------------------------------------------------
ARENA_GENERATION_ENABLED=true
ARENA_AUTO_PUBLISH_ENABLED=
ARENA_GENERATION_WINDOW_WEEKS=
ARENA_GENERATION_SIMILARITY_THRESHOLD=
ARENA_GENERATION_PREVIEW_HOURS=
# How long one provider attempt may take, in ms (default 90000, range
# 15000-240000). Writing a whole project package is a large completion; the old
# hard-coded 15s aborted every attempt mid-flight and logged it as a provider
# failure. Generation runs in a scheduled job, so nobody waits on this.
ARENA_GENERATION_TIMEOUT_MS=

# ---- Admin console --------------------------------------------------------
# INTERNAL_ADMIN_TOKEN must differ from INTERNAL_AUTOMATION_TOKEN. Scopes are a
# subset of: overview reviews weeks projects rewards users storage.
INTERNAL_ADMIN_TOKEN=
INTERNAL_ADMIN_SUBJECT=
INTERNAL_ADMIN_SCOPES=
ARENA_ADMIN_SUBJECTS=
ARENA_ADMIN_ROLES=

# ---- Optional integrations -------------------------------------------------
# Voucher fulfilment with the main site checkout.
MAIN_SITE_ORIGIN=
MAIN_SITE_VOUCHER_TOKEN=
# External careers portal linked from the Jobs page (HTTPS, no live openings).
JOBS_PORTAL_URL=
# Per-source job board tokens, one line each (see docs/backend/JOBS_PIPELINE.md).
# JOBS_PROVIDER_TOKEN=

# ---- Fast non-reasoning provider for CV Scanner (optional) ----------------
# Only if NEXT_PUBLIC_CV_SCANNER_ENABLED=true was baked into the image.
AI_CV_API_BASE_URL=
AI_CV_API_KEY=
AI_CV_MODEL=
CV_SCAN_HOURLY_CAP=

# ---- Outbound VPS webhooks: leave UNSET -----------------------------------
# The push hooks pointed at the old alvin box. A missing VPS_WEBHOOK_TOKEN makes
# src/server/automation/vps-hooks.ts skip cleanly. Do not set these.
# VPS_WEBHOOK_TOKEN=
# VPS_WEBHOOK_BASE_URL=

# ---- Caddy -----------------------------------------------------------------
ACME_EMAIL=ops@sekolahkarir.id
